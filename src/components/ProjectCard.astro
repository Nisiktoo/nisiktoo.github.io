---
interface Project {
  title: string;
  summary: string;
  stack: string[];
  href: string;
}

const { project } = Astro.props as { project: Project };
---

<article class="card project-card">
  <div class="card-topline">
    <span class="badge">Project</span>
    <span class="dot" aria-hidden="true"></span>
  </div>
  <h3>{project.title}</h3>
  <p>{project.summary}</p>
  <div class="chip-row">
    {project.stack.map((item) => <span class="chip">{item}</span>)}
  </div>
  <a href={project.href} class="text-link">Explore</a>
</article>
